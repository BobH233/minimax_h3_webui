+_PROGRESS_STAGES = {"denoising", "postprocessing"}
+
+
+def _report_video_progress(
+    batch: Req, stage: str, current_step: int, total_steps: int
+) -> None:
+    progress_dir = os.environ.get("SGLANG_VIDEO_PROGRESS_DIR")
+    if not progress_dir or stage not in _PROGRESS_STAGES:
+        return
+    request_id = batch.extra.get("parent_request_id") or batch.request_id
+    if not request_id:
+        output_file_name = getattr(batch, "output_file_name", None)
+        request_id = os.path.splitext(
+            os.path.basename(str(output_file_name or ""))
+        )[0]
+    if not request_id:
+        return
+    request_id = str(request_id)
+    filename = hashlib.sha256(request_id.encode("utf-8")).hexdigest()
+    path = os.path.join(progress_dir, filename + ".progress")
+    temporary_path = f"{path}.{os.getpid()}.tmp"
+    try:
+        os.makedirs(progress_dir, exist_ok=True)
+        with open(temporary_path, "w", encoding="utf-8") as progress_file:
+            progress_file.write(
+                f"{request_id} {stage} {current_step} {total_steps}\n"
+            )
+        os.replace(temporary_path, path)
+    except OSError:
+        try:
+            os.remove(temporary_path)
+        except OSError:
+            pass
+        logger.debug("Failed to report video progress", exc_info=True)
 
 
