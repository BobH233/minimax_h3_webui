+_PROGRESS_STAGES = {"denoising", "postprocessing"}
+
+
+def _progress_path(video_id: str) -> str | None:
+    progress_dir = os.environ.get("SGLANG_VIDEO_PROGRESS_DIR")
+    if not progress_dir:
+        return None
+    filename = hashlib.sha256(video_id.encode("utf-8")).hexdigest() + ".progress"
+    return os.path.join(progress_dir, filename)
+
+
+def _read_live_progress(video_id: str) -> dict[str, Any]:
+    progress_dir = os.environ.get("SGLANG_VIDEO_PROGRESS_DIR")
+    if not progress_dir:
+        return {}
+    try:
+        paths = [
+            entry.path
+            for entry in os.scandir(progress_dir)
+            if entry.name.endswith(".progress")
+        ]
+    except OSError:
+        return {}
+    for path in paths:
+        try:
+            with open(path, encoding="utf-8") as progress_file:
+                reported_id, stage, current_text, total_text = (
+                    progress_file.read().split()
+                )
+            current_step = int(current_text)
+            total_steps = int(total_text)
+        except (OSError, TypeError, ValueError):
+            continue
+        if reported_id != video_id and not reported_id.startswith(video_id + "_"):
+            continue
+        if (
+            stage not in _PROGRESS_STAGES
+            or total_steps <= 0
+            or current_step < 0
+            or current_step > total_steps
+        ):
+            continue
+        progress = min(95, round(5 + 90 * current_step / total_steps))
+        return {
+            "status": "processing",
+            "progress": progress,
+            "generation_stage": stage,
+            "current_step": current_step,
+            "total_steps": total_steps,
+        }
+    return {}
+
+
+def _video_job_with_progress(job: dict[str, Any]) -> dict[str, Any]:
+    result = dict(job)
+    if result.get("status") not in {"completed", "failed", "deleted"}:
+        result.update(_read_live_progress(str(result["id"])))
+    return result
+
+
+def _remove_progress(video_id: str) -> None:
+    progress_dir = os.environ.get("SGLANG_VIDEO_PROGRESS_DIR")
+    if not progress_dir:
+        return
+    try:
+        paths = [
+            entry.path
+            for entry in os.scandir(progress_dir)
+            if entry.name.endswith(".progress")
+        ]
+    except OSError:
+        return
+    for path in paths:
+        try:
+            with open(path, encoding="utf-8") as progress_file:
+                reported_id = progress_file.read().split(maxsplit=1)[0]
+            if reported_id == video_id or reported_id.startswith(video_id + "_"):
+                os.remove(path)
+        except (FileNotFoundError, IndexError, OSError):
+            continue
+
 
